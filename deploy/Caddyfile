{
    email {$SWW_TLS_EMAIL}
    servers {
        protocols h1 h2 h3
    }
    log default {
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers delete
            }
        }
    }
}
(tls_acme) {
}
(tls_internal) {
    tls internal
}
{$SWW_TLS_HOST} {
    import tls_{$SWW_CADDY_TLS:acme}
    request_body {
        max_size 30MB
    }
    # Forwarded website/client identity is admitted only from the named split frontend.
    @split_frontend remote_ip {$SWW_FRONTEND_CIDR:127.0.0.1/32}
    handle @split_frontend {
        reverse_proxy {$SWW_EDGE_UPSTREAM:frontend:8080} {
            header_up Host {http.request.header.X-Forwarded-Host}
            header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
            header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            header_up X-Real-IP {http.request.header.X-Real-IP}
            header_up -CF-Connecting-IP
            flush_interval -1
        }
    }
    handle {
    reverse_proxy {$SWW_EDGE_UPSTREAM:frontend:8080} {
        header_up X-Real-IP {remote_host}
        header_up -CF-Connecting-IP
        flush_interval -1
    }
}

}
