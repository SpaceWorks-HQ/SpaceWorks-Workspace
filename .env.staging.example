# Disposable staging only. Never use these values in production.
CI=true
ALLOW_INSECURE_PRODUCTION_TESTS=1
POSTGRES_PASSWORD=staging-only-password
REDIS_PASSWORD=staging-only-password
MINIO_ROOT_USER=sww-staging
MINIO_ROOT_PASSWORD=staging-storage-password
DATABASE_URL=postgresql://sww:staging-only-password@postgres:5432/sww_staging
DIRECT_URL=postgresql://sww:staging-only-password@postgres:5432/sww_staging
REDIS_URL=redis://:staging-only-password@redis:6379
AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001
AUTH_SECRET=staging-session-secret-at-least-32-characters
CRON_SECRET=staging-scheduler-secret-at-least-32-characters
HEALTHCHECK_SECRET=staging-readiness-secret-at-least-32-characters
# Generate independent base64 32-byte keys before building.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME
MFA_ENCRYPTION_KEY=CHANGE_ME
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME
VAULT_MASTER_KEY=CHANGE_ME
TRUSTED_PROXY_IP_HEADER=x-real-ip
S3_BUCKET=sww-staging
S3_REGION=us-east-1
S3_ENDPOINT=http://silo:9000
S3_ACCESS_KEY_ID=sww-staging
S3_SECRET_ACCESS_KEY=staging-storage-password
S3_FORCE_PATH_STYLE=1
EMAIL_FROM=Space Works Workspace <noreply@example.test>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_ALLOW_UNAUTHENTICATED=1
