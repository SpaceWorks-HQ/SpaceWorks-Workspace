# Public HTTPS edge for the Space Works Workspace VPS stack.
# Only this container publishes ports (80, 443/tcp, 443/udp for HTTP/3).
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

# `CADDY_TLS=acme` (default) obtains and renews a public certificate.
# `CADDY_TLS=internal` uses Caddy's local CA, for test hosts without public DNS.
(tls_acme) {
}
(tls_internal) {
	tls internal
}

{$PUBLIC_HOST} {
	import tls_{$CADDY_TLS:acme}

	# No access log: invitation and reset URLs are bearer capabilities.
	request_body {
		max_size 30MB
	}
	reverse_proxy app:3000 {
		# The app trusts X-Real-IP (TRUSTED_PROXY_IP_HEADER=x-real-ip); always overwrite it.
		header_up X-Real-IP {remote_host}
		header_up -CF-Connecting-IP
		header_up -X-Forwarded-For
		# Server-Sent Events (/api/realtime) must stream without buffering.
		flush_interval -1
	}
}
